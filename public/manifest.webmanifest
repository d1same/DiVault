{
  "name": "DiVault",
  "short_name": "DiVault",
  "description": "A private notes, files, secrets, calendar, tasks, and reminders workspace.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#eef2ff",
  "icons": [
    {
      "src": "/assets/divault-logo.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
