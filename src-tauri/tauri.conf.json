{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DiVault",
  "version": "1.0.1",
  "identifier": "com.divault.notes",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "../public",
      "../src",
      "resources/php"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
